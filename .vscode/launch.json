{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Flash + Debug (Debug)",
            "cwd": "${workspaceFolder}",
            "deviceName": "STM32C031C6T7",
            "deviceCore": "Cortex-M0+",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/ChargerPowerV4.elf"
                }
            ]
        },
        {
            "name": "Cortex-Debug: Flash + Debug (ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/ChargerPowerV4.elf",
            "servertype": "external",
            "gdbPath": "/opt/st/stm32cubeclt_1.21.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb",
            "gdbTarget": "localhost:61234",
            "preLaunchTask": "ST-Link GDB Server",
            "runToEntryPoint": "main"
        }
    ]
}
